{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@oguzkaganozt/opencode-studio",
  "version": "1.0.14",
  "description": "OpenCode Studios for CAD and PCB, plus always-on workspace media tools",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./server": "./dist/plugin.js",
    "./media-provider": "./dist/media-provider.js",
    "./media-go": "./dist/media-go.js"
  },
  "bin": {
    "opencode-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/postinstall-completion.mjs",
    "studios/cad/forge/forge_cli.py",
    "studios/cad/forge/pyproject.toml",
    "studios/cad/forge/uv.lock",
    "studios/cad/forge/.python-version",
    "studios/cad/skill/SKILL.md",
    "studios/pcb/skill/SKILL.md",
    "src/platform/media/skill/SKILL.md",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall-completion.mjs",
    "test": "bun test ./test/ ./ui/ ./studios/cad/test/ ./studios/cad/viewer/src/ ./src/platform/media/test/ ./studios/pcb/test/",
    "test:python": "uv run --project studios/cad/forge python -m unittest discover -s studios/cad/forge/tests -v",
    "test:package": "bun scripts/package-smoke.ts",
    "test:browser": "bun scripts/browser-smoke.ts",
    "test:browser:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test ui scripts studios --files-ignore-unknown=true",
    "format": "biome format --write .",
    "dev:ui": "vite",
    "build:runtime": "bun scripts/build.ts",
    "build:ui": "vite build",
    "build": "bun run build:runtime && bun run build:ui",
    "prepack": "bun run build",
    "check": "bun run typecheck && bun run test && bun run lint && bun run build",
    "create-studio": "bun scripts/create-studio.ts",
    "release:check": "bun run check && bun run test:python && bun run test:package && bun run test:browser"
  },
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.18.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.82",
    "@ai-sdk/openai-compatible": "2.0.41",
    "@fal-ai/client": "1.9.3",
    "@fontsource/barlow": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@opencode-ai/plugin": "1.18.15",
    "@opencode-ai/sdk": "1.18.15",
    "@tanstack/react-query": "5.101.2",
    "@tscircuit/3d-viewer": "0.0.577",
    "@tscircuit/copper-pour-solver": "0.0.39",
    "@tscircuit/image-utils": "0.0.8",
    "@tscircuit/infer-cable-insertion-point": "0.0.2",
    "@tscircuit/manifold-2d": "0.0.6",
    "@tscircuit/math-utils": "0.0.36",
    "@tscircuit/miniflex": "0.0.4",
    "@tscircuit/pcb-viewer": "1.11.375",
    "@tscircuit/schematic-trace-solver": "0.0.96",
    "@tscircuit/schematic-viewer": "2.0.74",
    "@tscircuit/solver-utils": "0.0.16",
    "@tscircuit/soup-util": "0.0.41",
    "calculate-elbow": "0.0.12",
    "circuit-json-to-spice": "0.0.43",
    "circuit-to-svg": "0.0.387",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "connectivity-map": "1.0.0",
    "env-paths": "4.0.0",
    "eventsource-parser": "3.0.8",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "file-type": "22.0.1",
    "flatbush": "4.6.2",
    "graphics-debug": "0.0.95",
    "hono": "4.12.30",
    "js-yaml": "4.1.0",
    "jsonc-parser": "3.3.1",
    "manifold-3d": "3.2.1",
    "minicssgrid": "0.0.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "8.2.0",
    "remark-gfm": "^4.0.1",
    "spicets": "0.0.2",
    "spicey": "0.0.14",
    "tailwind-merge": "3.6.0",
    "tscircuit": "0.0.2140",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/js-yaml": "4.0.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.3",
    "playwright": "1.51.0",
    "tailwindcss": "4.3.3",
    "three": "0.185.1",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cad",
    "media",
    "pcb",
    "studio",
    "files"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oguzkaganozt/opencode-studio.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
