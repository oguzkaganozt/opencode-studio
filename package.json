{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@oguzkaganozt/opencode-studio",
  "version": "1.0.15",
  "description": "Isolated OpenCode Studios for CAD, PCB, and Firmware workflows",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./server": "./dist/plugin.js"
  },
  "bin": {
    "opencode-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/postinstall-completion.mjs",
    "studios/cad/engine/cad_build.py",
    "studios/cad/engine/cad_runtime/**",
    "studios/cad/engine/pyproject.toml",
    "studios/cad/engine/uv.lock",
    "studios/cad/engine/.python-version",
    "studios/cad/tools/catalog.json",
    "studios/*/skill/SKILL.md",
    "studios/*/agent/*.md",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall-completion.mjs",
    "test": "bun test ./test/ ./ui/ ./studios/ ./src/platform/",
    "test:python": "uv run --project studios/cad/engine python -m unittest discover -s studios/cad/engine/tests -v",
    "test:package": "bun scripts/package-smoke.ts",
    "test:browser": "bun scripts/browser-smoke.ts",
    "test:browser:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test ui scripts studios --files-ignore-unknown=true",
    "format": "biome format --write .",
    "dev:ui": "vite",
    "build:runtime": "bun scripts/build.ts",
    "build:ui": "vite build",
    "build": "bun run build:runtime && bun run build:ui",
    "prepack": "bun run build",
    "check": "bun run typecheck && bun run test && bun run lint && bun run build",
    "create-studio": "bun scripts/create-studio.ts",
    "release:check": "bun run check && bun run test:python && bun run test:package && bun run test:browser"
  },
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.18.16"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5",
    "@fontsource/inter": "5",
    "@opencode-ai/plugin": "1.18.16",
    "@opencode-ai/sdk": "1.18.16",
    "@tanstack/react-query": "5.101.2",
    "@tscircuit/3d-viewer": "0.0.577",
    "@tscircuit/pcb-viewer": "1.11.375",
    "@tscircuit/schematic-viewer": "2.0.74",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "env-paths": "4.0.0",
    "eventsource-parser": "3.0.8",
    "file-type": "22.0.1",
    "hono": "4.12.30",
    "js-yaml": "4.1.0",
    "jsonc-parser": "3.3.1",
    "manifold-3d": "3.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "8.2.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.6.0",
    "tscircuit": "0.0.2306"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/js-yaml": "4.0.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.3",
    "playwright": "1.51.0",
    "tailwindcss": "4.3.3",
    "three": "0.185.1",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cad",
    "pcb",
    "firmware",
    "studio",
    "files"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oguzkaganozt/opencode-studio.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
