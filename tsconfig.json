{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@studios/*": ["studios/*"],
      "@ui/*": ["ui/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "studios/**/*.ts",
    "studios/**/*.tsx",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["dist", "node_modules", "opencode-*-studio", "studios/*/forge"]
}
