{
  "name": "opencode-startup-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic idea mining / research / paper-eval harness — OpenCode plugin + pool viewer",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/plugin.js",
    "./api": "./dist/server.js"
  },
  "bin": {
    "opencode-startup-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "opencode-studio.json",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build:runtime": "bun scripts/build.ts",
    "build:ui": "vite build",
    "build": "bun run typecheck && bun run build:runtime && bun run build:ui",
    "serve": "bun src/cli.ts serve --root ./workspace",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.18.2"
  },
  "dependencies": {
    "@fontsource/barlow": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@opencode-ai/plugin": "1.18.2",
    "@tanstack/react-query": "5.101.2",
    "hono": "4.12.30",
    "jsonc-parser": "3.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
