{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-cad-studio",
  "version": "0.1.0",
  "description": "Agentic CAD design harness \u2014 opencode plugin + web UI companion 3D viewer",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/plugin.js",
    "./api": "./dist/server.js"
  },
  "bin": {
    "opencode-cad-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "forge/forge_cli.py",
    "forge/pyproject.toml",
    "forge/uv.lock",
    "skills/cad-studio/SKILL.md",
    "opencode-studio.json",
    "examples/opencode.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:python": "uv run --project forge python -m unittest discover -s forge/tests -v",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "serve": "bun src/cli.ts serve --root .",
    "dev:ui": "vite",
    "build:runtime": "bun scripts/build.ts",
    "build:ui": "vite build",
    "build": "bun run build:runtime && bun run build:ui",
    "benchmark:organic": "bun scripts/organic-benchmark.ts",
    "check": "bun run typecheck && bun test && bun run test:python && bun run lint && bun run build",
    "test:package": "bun scripts/package-smoke.ts",
    "release:check": "bun run check && bun run test:package && bun run test:conformance",
    "prepack": "bun run check",
    "test:conformance": "bun ../opencode-studio-contract/conformance/src/run.ts --studio ."
  },
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.18.2"
  },
  "dependencies": {
    "@fontsource/barlow": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@opencode-ai/plugin": "1.18.2",
    "@opencode-ai/sdk": "1.18.2",
    "@tanstack/react-query": "5.101.2",
    "hono": "4.12.30",
    "jsonc-parser": "3.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "4.3.3",
    "three": "0.185.1",
    "typescript": "latest",
    "vite": "8.1.5"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cad",
    "build123d",
    "opencascade",
    "3d",
    "fdm",
    "agent"
  ]
}
