{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-pcb-studio",
  "version": "0.1.0",
  "description": "PCB schematic generation and viewing for OpenCode with tscircuit",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oguzkaganozt/opencode-pcb-studio.git"
  },
  "exports": {
    "./server": "./dist/plugin.js",
    "./api": "./dist/server.js"
  },
  "bin": {
    "opencode-pcb-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "opencode-studio.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "serve": "bun src/cli.ts serve --root .",
    "dev:ui": "vite",
    "build:runtime": "bun scripts/build.ts",
    "build:ui": "vite build",
    "build": "bun run build:runtime && bun run build:ui",
    "check": "bun run typecheck && bun test && bun run lint && bun run build",
    "test:package": "bun scripts/package-smoke.ts",
    "release:check": "bun run check && bun run test:package && bun run test:conformance",
    "test:conformance": "bun ../opencode-studio-contract/conformance/src/run.ts --studio ."
  },
  "engines": {
    "bun": ">=1.3.0",
    "opencode": ">=1.18.2"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@fontsource/barlow": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@opencode-ai/plugin": "1.18.2",
    "@tanstack/react-query": "5.101.2",
    "@tscircuit/3d-viewer": "^0.0.577",
    "@tscircuit/copper-pour-solver": "0.0.39",
    "@tscircuit/image-utils": "0.0.8",
    "@tscircuit/infer-cable-insertion-point": "0.0.2",
    "@tscircuit/manifold-2d": "0.0.6",
    "@tscircuit/math-utils": "0.0.36",
    "@tscircuit/miniflex": "0.0.4",
    "@tscircuit/pcb-viewer": "1.11.375",
    "@tscircuit/schematic-trace-solver": "0.0.96",
    "@tscircuit/schematic-viewer": "2.0.74",
    "@tscircuit/solver-utils": "0.0.16",
    "@tscircuit/soup-util": "0.0.41",
    "calculate-elbow": "0.0.12",
    "circuit-json-to-spice": "0.0.43",
    "circuit-to-svg": "0.0.387",
    "connectivity-map": "1.0.0",
    "debug": "^4.4.3",
    "flatbush": "4.6.2",
    "graphics-debug": "0.0.95",
    "hono": "4.12.30",
    "js-yaml": "4.1.0",
    "jsonc-parser": "3.3.1",
    "minicssgrid": "0.0.9",
    "pure-rand": "^8.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.2.0",
    "spicets": "0.0.2",
    "spicey": "0.0.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "@types/js-yaml": "4.0.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "latest",
    "vite": "8.1.5"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pcb",
    "schematic",
    "tscircuit",
    "electronics",
    "eda"
  ]
}
